# =============================================================================
# /etc/odooguard/odooguard.conf  -  propriétaire odooguard, droits 600
# Modèle versionné : AUCUN secret ici. Les secrets sont dans des fichiers à part
# (restic.pass, pgpass, phrase de chiffrement pgBackRest) ou dans l'environnement
# (ODOOGUARD_<SECTION>_<CLE>).
# Les valeurs marquées [À VÉRIFIER] doivent être confirmées sur server01.
# =============================================================================

[general]
site = LNHC
state_dir = /var/lib/odooguard
log_dir = /var/log/odooguard
lock_dir = /run/odooguard
# Zone de travail des restaurations (instance temporaire) : prévoir la taille
# de la plus grosse base restaurée + marge.
staging_dir = /srv/odooguard/staging
# Espace libre minimal exigé sur le disque des dépôts avant toute sauvegarde
min_free_gb = 50

[odoo]
host = 192.168.8.80
ssh_user = root
ssh_key = /etc/odooguard/ssh/id_agent
# [À VÉRIFIER] : psql -V et pg_lsclusters sur server01
pg_version = 15
pg_cluster = main
odoo_service = odoo
odoo_conf = /etc/odoo/odoo.conf
odoo_url = http://192.168.8.80:8069
filestore_path = /var/lib/odoo/.local/share/Odoo/filestore
databases = LNHC_Prod_2025, LNHC_08_07_26
# Répertoires sauvegardés par rsync (pull, lecture seule) puis restic.
# [À VÉRIFIER] : chemin des modules additionnels (addons_path dans odoo.conf).
file_sources =
    /var/lib/odoo/.local/share/Odoo/filestore,
    /etc/odoo,
    /opt/odoo/custom-addons,
    /etc/postgresql,
    /etc/pgbackrest,
    /etc/systemd/system,
    /etc/nginx,
    /var/lib/odooguard-export
rsync_excludes = sessions/, *.pyc, __pycache__/
# Limite de débit rsync de 8h à 18h (impact Odoo). Vide = pas de limite.
rsync_bwlimit_day = 40M

[pgbackrest]
stanza = lnhc
config = /etc/pgbackrest/pgbackrest.conf
ingest_config = /etc/pgbackrest/odooguard-ingest.conf
repo_path = /srv/odooguard/pgbackrest
wal_spool = /srv/odooguard/wal-spool
pg_shadow = /var/lib/odooguard/pgshadow
wal_keep_local = 256
wal_receiver_unit = odooguard-walreceiver.service
pg_bin_dir = /usr/lib/postgresql/15/bin

[restic]
repository = /srv/odooguard/restic
password_file = /etc/odooguard/restic.pass
mirror_dir = /srv/odooguard/mirror
keep_hourly = 48
keep_daily = 14
keep_weekly = 8
keep_monthly = 12

[thresholds]
# Âge maximal (secondes) avant alerte critique
wal_max_lag = 600
db_any_max_age = 93600
db_full_max_age = 691200
files_max_age = 3600
copy_max_age = 10800

# ----------------------------------------------------------------- cibles
# VM de test isolée (restaurations de contrôle, phase 3)
[target:testvm]
host = 192.168.8.82
ssh_user = root
ssh_key = /etc/odooguard/ssh/id_agent
pg_version = 15
odoo_url = http://192.168.8.82:8069
is_production = no

# ----------------------------------------------------------------- copies NAS
[destination:nas1]
# NAS principal 192.168.8.30, partage CIFS « odoo » (cf. /etc/fstab)
mountpoint = /mnt/nas-odoo
path = /mnt/nas-odoo/odooguard
min_free_gb = 500

[destination:nas2]
# NAS secondaire 192.168.3.19, partage « Backups »
mountpoint = /mnt/nas-backups
path = /mnt/nas-backups/odooguard
min_free_gb = 500

# ============================================================== phase 2
# ----------------------------------------------------------------- alertes
[alerts]
# journal (toujours actif), email, telegram
channels = journal, email, telegram
# Niveau minimal notifié par e-mail / Telegram : warning ou critical
min_level = warning
# Rappel tant qu'un problème persiste (heures)
repeat_hours = 4
send_resolved = yes

[smtp]
# [À COMPLÉTER] relais SMTP interne ou Office 365 (smtp.office365.com:587 starttls)
host = smtp.example.lan
port = 587
# starttls | ssl | none
security = starttls
user =
# Mot de passe dans un fichier 600 (jamais ici)
password_file = /etc/odooguard/smtp.pass
from = odooguard@example.lan
to = informatique@example.lan

[telegram]
# Jeton du bot (BotFather) dans un fichier 600 ; chat_ids : utilisateurs ou groupe
token_file = /etc/odooguard/telegram.token
chat_ids =
# Si l'accès Internet passe par un proxy :
https_proxy =

# ----------------------------------------------------------------- tableau de bord
[web]
listen = 0.0.0.0
port = 8443
certfile = /etc/odooguard/web/odooguard.crt
keyfile = /etc/odooguard/web/odooguard.key
users_file = /etc/odooguard/web/users
secret_file = /etc/odooguard/web/secret
session_hours = 8
# Copie publique de l'état pour Zabbix (sans secret)
public_status = /var/lib/odooguard-public/status.json

# ----------------------------------------------------------------- composants extérieurs
# Rapports envoyés par les scripts PowerShell (deploy/windows/Send-OdooGuardReport.ps1)
[external:veeam]
label = Veeam B&R (sauvegarde des VM)
# Alerte critique si aucune sauvegarde Veeam réussie depuis 26 h
max_age = 93600
token_file = /etc/odooguard/tokens/veeam

[external:offline]
label = Copie hors ligne G:\
# Copie hebdomadaire : 8 jours de tolérance [À AJUSTER au rythme réel]
max_age = 691200
token_file = /etc/odooguard/tokens/offline

# ============================================================== phase 3
# ----------------------------------------------------------------- test de restauration
[restore_test]
# Cible isolée : section [target:testvm] (jamais la production)
target = testvm
# Bases testées (vide = toutes celles de [odoo] databases)
databases = LNHC_Prod_2025
# Instant restauré : valide aussi la restauration à un instant précis (PITR)
point = hier 16:00
# Nombre de bases de test « ogtest_* » conservées sur la VM pour consultation
keep_last = 1
# Écart maximal des comptages de contrôle par rapport à la production (10 %)
tolerance = 0.10
# Dernière activité (messages Odoo) plus ancienne que N jours : avertissement
max_staleness_days = 7
start_odoo = yes
http_timeout = 300
# Critique si aucun test réussi depuis 8 jours
max_age = 691200
