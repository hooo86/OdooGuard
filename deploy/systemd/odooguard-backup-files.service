[Unit]
Description=OdooGuard - sauvegarde filestore / modules / configuration (rsync + restic)
After=network-online.target
Wants=network-online.target
OnFailure=odooguard-notify@%n.service

[Service]
Type=oneshot
User=odooguard
Group=odooguard
RuntimeDirectory=odooguard
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/bin/odooguard backup files --wait=900
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
