# Test de restauration hebdomadaire sur la VM de test isolée, avec rapport
# envoyé par e-mail / Telegram et visible au tableau de bord.
[Unit]
Description=OdooGuard - test de restauration hebdomadaire
After=network-online.target
Wants=network-online.target
OnFailure=odooguard-notify@%n.service

[Service]
Type=oneshot
User=odooguard
Group=odooguard
RuntimeDirectory=odooguard
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/bin/odooguard restore-test --scheduled --wait=3600
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=10h
